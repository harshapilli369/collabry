# Frontend environment variables (Vite)
# Copy this file to .env and fill in your values. Do not commit .env to Git.
#   cp .env.example .env

# Google OAuth Client ID (from Google Cloud Console > Credentials)
VITE_GOOGLE_CLIENT_ID=your_google_client_id

# Backend API base URL (must match the port your backend runs on)
VITE_API_BASE_URL=http://localhost:9090/api/auth
