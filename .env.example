# Root .env for Docker Compose (docker-compose up)
# Copy this file to .env and fill in your values. Do not commit .env to Git.
#   cp .env.example .env   (or on Windows: copy .env.example .env)

# ============================================================
# Frontend (Vite build-time variables)
# ============================================================

# Google OAuth Client ID (from Google Cloud Console > Credentials)
VITE_GOOGLE_CLIENT_ID=your_google_client_id

# Backend API base URL (browser uses this; keep localhost when running Docker locally)
VITE_API_BASE_URL=http://localhost:9090/api/auth

# ============================================================
# Backend – Server
# ============================================================

# Port the Spring Boot server listens on (default: 9090)
SERVER_PORT=9090

# ============================================================
# Backend – Database
# ============================================================

# For local development, leave these commented out to use H2 (zero setup).
# For production, set to your MySQL connection:
# SPRING_DATASOURCE_URL=jdbc:mysql://host:3306/your_database
# SPRING_DATASOURCE_USERNAME=your_db_user
# SPRING_DATASOURCE_PASSWORD=your_db_password

# ============================================================
# Backend – SMTP / Gmail (signup confirmation, password reset)
# ============================================================

# Without these, confirmation emails are only logged to the console.
# To send real emails:
#   1. Enable 2-Step Verification on your Gmail account
#   2. Create an App Password: https://myaccount.google.com/apppasswords
#   3. Use the 16-character App Password below (no spaces)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=465
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_16_char_app_password_no_spaces
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=false
SPRING_MAIL_PROPERTIES_MAIL_SMTP_SSL_ENABLE=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_SSL_TRUST=*
APP_MAIL_FROM=your_email@gmail.com

# ============================================================
# Backend – Cloudinary (image upload)
# ============================================================

# Sign up at https://cloudinary.com → Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ============================================================
# Backend – Groq API (AI features: campaign description, bio enhancement)
# ============================================================

# Get a key at https://console.groq.com/keys (optional; AI features disabled without it)
GROQ_API_KEY=your_groq_api_key
